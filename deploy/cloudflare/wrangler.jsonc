{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calibre-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
