{
  "name": "@calibre-cloud/deploy-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @calibre-cloud/web run build && node scripts/assemble.ts",
    "dev": "wrangler dev",
    "smoke:local": "node smoke/local.ts",
    "smoke:deployed": "node smoke/deployed.ts",
    "release": "node scripts/release.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
